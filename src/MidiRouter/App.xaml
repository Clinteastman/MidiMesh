<Application
    x:Class="MidiRouter.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- The same green as the icon and the activity lights. -->
            <Color x:Key="SystemAccentColor">#FF50DC6E</Color>
            <Color x:Key="SystemAccentColorLight1">#FF6FE587</Color>
            <Color x:Key="SystemAccentColorLight2">#FF8DEDA0</Color>
            <Color x:Key="SystemAccentColorLight3">#FFB0F4BE</Color>
            <Color x:Key="SystemAccentColorDark1">#FF3FB859</Color>
            <Color x:Key="SystemAccentColorDark2">#FF2F9445</Color>
            <Color x:Key="SystemAccentColorDark3">#FF217032</Color>
            <SolidColorBrush x:Key="LightOnBrush" Color="#FF50DC6E" />
            <SolidColorBrush x:Key="LightIdleBrush" Color="#FF3A4F42" />
            <SolidColorBrush x:Key="WarningTextBrush" Color="#FFF2B84B" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
