<Window
    x:Class="MidiMesh.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar drawn by the app; the system draws only the min, max and close buttons. -->
        <Grid x:Name="AppTitleBar" Height="40" Padding="14,0,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="TitleIcon" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Padding="20,6,20,12" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Routes" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="SummaryText" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
            <Button x:Name="PanicButton" Grid.Column="1" Click="OnPanicClick" AutomationProperties.Name="Panic"
                    ToolTipService.ToolTip="Stop stuck notes: send all notes off to every routed output">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7BA;" FontSize="14" />
                    <TextBlock Text="Panic" />
                </StackPanel>
            </Button>
            <Button x:Name="ReconnectButton" Grid.Column="2" Click="OnReconnectClick" AutomationProperties.Name="Reconnect all"
                    ToolTipService.ToolTip="Close and reopen every MIDI port">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Reconnect" />
                </StackPanel>
            </Button>
            <Button Grid.Column="3" AutomationProperties.Name="More options" ToolTipService.ToolTip="More">
                <FontIcon Glyph="&#xE712;" FontSize="14" />
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight" Opening="OnMoreOpening"
                                MenuFlyoutPresenterStyle="{StaticResource SolidMenuFlyoutStyle}">
                        <ToggleMenuFlyoutItem x:Name="StartupItem" Text="Start with Windows" Click="OnStartupClick" />
                        <!-- Filled in by BuildAppearanceMenu: backdrop, accent colour, theme. -->
                        <MenuFlyoutSubItem x:Name="AppearanceItem" Text="Appearance">
                            <MenuFlyoutSubItem.Icon>
                                <FontIcon Glyph="&#xE790;" />
                            </MenuFlyoutSubItem.Icon>
                        </MenuFlyoutSubItem>
                        <MenuFlyoutItem Text="Open log folder" Click="OnOpenLogClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE838;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="UpdateItem" Text="Check for updates" Click="OnCheckUpdatesClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE895;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Quit (stop routing)" Click="OnQuitClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE7E8;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="VersionItem" IsEnabled="False" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- Update messages: "ready, restart to finish", or the result of Check for updates. -->
        <InfoBar x:Name="UpdateBar" Grid.Row="2" Margin="20,0,20,12" IsOpen="False" IsClosable="True">
            <InfoBar.ActionButton>
                <Button x:Name="RestartButton" Content="Restart now" Click="OnRestartClick" Visibility="Collapsed"
                        ToolTipService.ToolTip="Routing stops for a few seconds while it restarts" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- Routing grid -->
        <Border Grid.Row="3" Margin="20,0,20,0" Padding="16,12,16,12" CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <ScrollViewer x:Name="MatrixScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Auto" VerticalScrollMode="Auto">
                <Grid x:Name="Matrix" HorizontalAlignment="Left" VerticalAlignment="Top" />
            </ScrollViewer>
        </Border>

        <!-- Status line: the last plug, unplug or error event. -->
        <TextBlock x:Name="StatusText" Grid.Row="4" Margin="22,8,20,10" Opacity="0.55"
                   Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
