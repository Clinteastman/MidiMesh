<Application
    x:Class="MidiMesh.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The app theme (dark or light) is set in code from settings.json; see AppearanceManager. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Popups and menus normally use see-through acrylic and a system-drawn shadow. On an
                HDR screen both rendered badly (grid showing through, a second shadow offset to one
                side), so popups here are solid with a plain border and no built-in shadow.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AcrylicInAppFillColorDefaultBrush" Color="#FF2B2E2C" />
                    <SolidColorBrush x:Key="AcrylicBackgroundFillColorDefaultBrush" Color="#FF2B2E2C" />
                    <SolidColorBrush x:Key="PopupFillBrush" Color="#FF2B2E2C" />
                    <SolidColorBrush x:Key="PopupBorderBrush" Color="#FF4A504C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AcrylicInAppFillColorDefaultBrush" Color="#FF2B2E2C" />
                    <SolidColorBrush x:Key="AcrylicBackgroundFillColorDefaultBrush" Color="#FF2B2E2C" />
                    <SolidColorBrush x:Key="PopupFillBrush" Color="#FF2B2E2C" />
                    <SolidColorBrush x:Key="PopupBorderBrush" Color="#FF4A504C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AcrylicInAppFillColorDefaultBrush" Color="#FFF9F9F9" />
                    <SolidColorBrush x:Key="AcrylicBackgroundFillColorDefaultBrush" Color="#FFF9F9F9" />
                    <SolidColorBrush x:Key="PopupFillBrush" Color="#FFF9F9F9" />
                    <SolidColorBrush x:Key="PopupBorderBrush" Color="#FFD3D6D4" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- The same green as the icon and the activity lights. Other accents are set in code. -->
            <Color x:Key="SystemAccentColor">#FF50DC6E</Color>
            <Color x:Key="SystemAccentColorLight1">#FF6FE587</Color>
            <Color x:Key="SystemAccentColorLight2">#FF8DEDA0</Color>
            <Color x:Key="SystemAccentColorLight3">#FFB0F4BE</Color>
            <Color x:Key="SystemAccentColorDark1">#FF3FB859</Color>
            <Color x:Key="SystemAccentColorDark2">#FF2F9445</Color>
            <Color x:Key="SystemAccentColorDark3">#FF217032</Color>
            <SolidColorBrush x:Key="LightOnBrush" Color="#FF50DC6E" />
            <SolidColorBrush x:Key="LightIdleBrush" Color="#FF3A4F42" />
            <!-- One brush each, recoloured in code for the light theme, as the window keeps hold of them. -->
            <SolidColorBrush x:Key="WarningTextBrush" Color="#FFF2B84B" />

            <Style x:Key="SolidFlyoutStyle" TargetType="FlyoutPresenter">
                <Setter Property="Background" Value="{ThemeResource PopupFillBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource PopupBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="18,16" />
                <Setter Property="MaxWidth" Value="480" />
                <Setter Property="IsDefaultShadowEnabled" Value="False" />
            </Style>
            <Style x:Key="SolidMenuFlyoutStyle" TargetType="MenuFlyoutPresenter">
                <Setter Property="Background" Value="{ThemeResource PopupFillBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource PopupBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="IsDefaultShadowEnabled" Value="False" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
