<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- The routing logic is plain C#, so it is compiled in here directly instead of
         referencing the WinUI app project. -->
    <Compile Include="..\..\src\MidiRouter\Routing\RouteOptions.cs" Link="Linked\RouteOptions.cs" />
    <Compile Include="..\..\src\MidiRouter\Routing\RouteFilter.cs" Link="Linked\RouteFilter.cs" />
    <Compile Include="..\..\src\MidiRouter\Routing\RouteStore.cs" Link="Linked\RouteStore.cs" />
    <Compile Include="..\..\src\MidiRouter\AppPaths.cs" Link="Linked\AppPaths.cs" />
    <Compile Include="..\..\src\MidiRouter\Log.cs" Link="Linked\Log.cs" />
  </ItemGroup>
</Project>
